#!/usr/bin/env bash
# Сверка утверждений коммита с его содержимым (AGENTS.md §2.3, скил
# comfyui-task-acceptance): «зелёный check.py» ≠ «задача сделана».
# Обход: git commit --no-verify (происходит сознательно и осознаётся так).
# ВАЖНО: копия должна быть исполняемой — chmod +x, иначе git молча её пропустит.
set -e

msg_file="$1"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then exit 0; fi
msg="$(cat "$msg_file")"

# Сюда попадают только изменения из индекса (что реально уйдёт в коммит).
staged="$(git diff --cached --name-only 2>/dev/null || true)"
if [ -z "$staged" ]; then exit 0; fi

block=0
say() { printf '%s\n' "$1"; }

# ---------------------------------------------------------------------------
# 1. ⛔ Утечка бэкапов/мутаций: файлы, которых не должно быть в репозитории.
#    Ловит незавершённую приёмку по comfyui-mutation-testing (§2).
# ---------------------------------------------------------------------------
leak="$(printf '%s\n' "$staged" | grep -E '(\.bak|\.orig|\.rej|~)$' || true)"
if [ -n "$leak" ]; then
  block=1
  say "Коммит остановлен: в индексе файлы-бэкапы (утёкшая мутация):"
  printf '%s\n' "$leak" | sed 's/^/  - /'
  say "Восстанови оригинал и убери бэкап: git restore --staged <файл> && rm <файл>"
fi

# ---------------------------------------------------------------------------
# 2. ⛔ Утверждённые в сообщении файлы обязаны быть в коммите.
#    Ловит «поправил web/js/x.js», где .js в diff отсутствует (Degg_Crop:2026-10-03).
# ---------------------------------------------------------------------------
named="$(printf '%s\n' "$msg" | grep -oE '[A-Za-z0-9_][A-Za-z0-9_./-]*\.(py|js|mjs|jsx|ts|tsx)' | sort -u || true)"
for tok in $named; do
  base="${tok##*/}"
  found=0
  while IFS= read -r sf; do
    [ -n "$sf" ] || continue
    if [ "${sf##*/}" = "$base" ]; then found=1; break; fi
  done <<EOF
$staged
EOF
  if [ "$found" -eq 0 ]; then
    block=1
    say "Коммит остановлен: сообщение называет файл '$tok', но его нет в индексе."
    say "  Файл не менялся — убери утверждение из сообщения (AGENTS.md §2.3)."
  fi
done

# ---------------------------------------------------------------------------
# 3. ⛔ Глагол «сделано» без следа приёмки в сообщении.
#    Ловит отчёт об успехе без доказательства (AGENTS.md §2.3).
# ---------------------------------------------------------------------------
claim="$(printf '%s\n' "$msg" | grep -icE 'готово|сделано|исправл|убран|добавл|оставлен|перенес|устранён|устранен|работает' || true)"
evid="$(printf '%s\n' "$msg" | grep -icE 'ok:|fail|зелён|зелен|провер|тест|проба|скриншот|check\.py|до→после|доказательств|git show|--stat' || true)"
if [ "${claim:-0}" -gt 0 ] && [ "${evid:-0}" -eq 0 ]; then
  block=1
  say "Коммит остановлен: сообщение сообщает об успехе («сделано/исправлено/убрано»),"
  say "  но не содержит следа приёмки (вывод check.py / пробы / FAIL / скриншот)."
  say "  Добавь доказательство по сути задачи или переформулируй без утверждения."
  say "  Подробнее: AGENTS.md §2.3, скил comfyui-task-acceptance."
fi

if [ "$block" -ne 0 ]; then
  echo
  echo "Обход только осознанный: git commit --no-verify"
  exit 1
fi
exit 0
